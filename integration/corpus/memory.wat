(module
  (memory 1 2)
  (data (i32.const 0) "abcd")
  (data $passive "PQRS")
  (global $evaluations (export "evaluations") (mut i32) (i32.const 0))
  (func $length (param i32) (result i32)
    global.get $evaluations i32.const 1 i32.add global.set $evaluations
    local.get 0)
  (func (export "fill") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 call $length memory.fill)
  (func (export "copy") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.copy)
  (func (export "init") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.init $passive)
  (func (export "drop_data") data.drop $passive)
  (func (export "read") (param i32) (result i32) local.get 0 i32.load8_u)
  (func (export "word") (param i32) (result i32) local.get 0 i32.load)
  (func (export "pages") (result i32) memory.size)
  (func (export "grow") (param i32) (result i32) local.get 0 memory.grow))
