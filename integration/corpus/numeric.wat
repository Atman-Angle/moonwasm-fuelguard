(module
  (global $value (mut f64) (f64.const -0.0))
  (global $constant f64 (f64.const 1.5))
  (global $nan_literal f64 (f64.const -nan:0x8000000000042))
  (func (export "add32") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func (export "shift64") (param i64 i64) (result i64)
    local.get 0 local.get 1 i64.shr_u)
  (func (export "divide") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.div_s)
  (func (export "nearest") (param f32) (result f32)
    local.get 0 f32.nearest)
  (func (export "global_bits") (result i64) global.get $value i64.reinterpret_f64)
  (func (export "literal_bits") (result i64) global.get $nan_literal i64.reinterpret_f64)
  (func (export "global_add") (param f64) (result f64)
    local.get 0 global.get $constant f64.add global.set $value global.get $value)
  (func (export "nan") (result f64) f64.const 0 f64.const 0 f64.div)
