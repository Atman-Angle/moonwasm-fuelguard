///|
test "sha256_words matches reference digests across padding boundaries" {
  let sizes = [1, 3, 55, 56, 63, 64, 65, 4096]
  let expected = [
    [-159731446, -723204815, 565618174, 1302970637, -555153991, 2027124877, 656660415, -1396823895],
    [-559748228, -380898448, 322188431, 826643905, 2063157768, 1303526447, -1130656827, 809461778],
    [-1462348712, 240713144, 1865638902, 170589829, -852709392, 660180000, 1763032574, -473828290],
    [-284064421, -1142270559, 1651636301, -634302283, -1341286943, -485445818, -851910911, -747293233],
    [2004454994, -183908485, -2060670507, -1856687642, -1033138082, 125176687, 125945875, -1050307169],
    [1658609232, 1018611345, -608542093, 1715564159, -1248672368, 1350087146, 2070008649, 1339323696],
    [943636682, 317511354, 311910721, -941965054, -1001370096, -1501514211, 1248506899, -765698406],
    [-807933589, 1631200399, 1145861550, -1471824509, -268182326, 1702735228, 1915947960, 668078838],
  ]
  for k in 0..<sizes.length() {
    let n = sizes[k]
    let data = Bytes::makei(n, i => {
      if i % 3 == 0 {
        b'F'
      } else if i % 3 == 1 {
        b'G'
      } else {
        b'!'
      }
    })
    let words = sha256_words(data)
    for j in 0..<8 {
      assert_eq(words[j], expected[k][j])
    }
  }
}
